    "subscription.paywall.autoRenew" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Payment will be charged to your Apple ID account. Subscription renews automatically unless cancelled at least 24 hours before the end of the current period."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Оплата списывается с учётной записи Apple ID. Подписка продлевается автоматически, если её не отменить минимум за 24 часа до конца периода."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
