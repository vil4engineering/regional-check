    "Onboarding body": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Built for CarPlay so you can check the alert status at a glance — without taking your attention off the road."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для водителя в CarPlay: не отвлекаясь, одним взглядом посмотреть статус тревоги."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Для водія в CarPlay: не відволікаючись, одним поглядом побачити статус тривоги."
          }
        }
      }
    },
