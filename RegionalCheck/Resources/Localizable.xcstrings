    "outsideUkraine.body" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Drive Check shows regional alert status for Ukraine. Your location is outside Ukraine, so the app uses Kyiv by default."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Drive Check показывает региональный статус тревог для Украины. Ваше местоположение вне Украины, поэтому по умолчанию выбран Киев."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Drive Check показує регіональний статус тривог для України. Ваше місце розташування поза Україною, тому за замовчуванням обрано Київ."
          }
        }
      }
    },
