    "status.explanation.loud" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alert is active — stay careful; bridges may be closed."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сейчас громко — будьте осторожны, мосты могут быть перекрыты."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Зараз гучно — будьте обережні, мости можуть бути перекриті."
          }
        }
      }
    },
    "status.explanation.quiet" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "All quiet — you can drive calmly."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сейчас тихо — можно ехать спокойно."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Зараз тихо — можна їхати спокійно."
          }
        }
      }
    },
