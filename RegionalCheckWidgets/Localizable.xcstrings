    "subscription.paywall.subtitle": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unlock Live Activity and richer status detail during a Drive Check session."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разблокируйте Live Activity и расширенные детали статуса на время сессии Drive Check."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Розблокуйте Live Activity і розширені деталі статусу під час сесії Drive Check."
          }
        }
      }
    },
    "subscription.benefit.liveActivity": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Live Activity on Lock Screen and Dynamic Island while Drive Check is active"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Live Activity на экране блокировки и в Dynamic Island, пока Drive Check активен"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Live Activity на екрані блокування та в Dynamic Island, поки Drive Check активний"
          }
        }
      }
    },
    "subscription.benefit.badge": {
      "localizations": {
